{
  "name": "fleur",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "fleur": "./bin/fleur.ts"
  },
  "files": [
    "bin",
    "src",
    "docs/cli.md",
    "docs/upgrades.md",
    "docs/project-creation.md",
    "docs/setup.md",
    "docs/setup-arch-services.md",
    "docs/setup-desktop.md",
    "docs/setup-artifact-evidence.md",
    "dist/reference",
    "docs/read-pages.md",
    "docs/development.md",
    "docs/production.md",
    "docs/application-surface.md",
    "docs/reactivity.md",
    "docs/mutations.md",
    "docs/maintenance.md",
    "docs/retrieval.md"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "test": "bun scripts/test-local.ts",
    "types": "bun ./node_modules/typescript/bin/tsc --noEmit && bun ./node_modules/typescript/bin/tsc --noEmit -p tests/runtime/tsconfig.json",
    "lint": "bun ./node_modules/oxlint/bin/oxlint bin src tests/cli tests/ci tests/runtime scripts && bun ./lint/node_modules/eslint/bin/eslint.js --config lint/eslint.config.mjs bin src tests/cli tests/ci tests/runtime scripts",
    "build:reference": "bun ./node_modules/typescript/bin/tsc -p tsconfig.declarations.json && bun scripts/verify-read-reference.ts",
    "prepack": "\"$npm_execpath\" ./node_modules/typescript/bin/tsc -p tsconfig.declarations.json"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.3",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@tailwindcss/oxide": "4.3.3",
    "preact": "11.0.1",
    "preact-render-to-string": "6.8.0",
    "rolldown": "1.2.15",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "exports": {
    "./schema": "./src/schema.ts",
    "./database": "./src/database.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./routing": "./src/routing.ts"
  }
}
